---
import Base from '@/layouts/Base.astro';
import { getDict, detectLocaleFromUrl } from '@/i18n';
import RepoCard from '@components/RepoCard.astro';
import ModelCard from '@components/ModelCard.astro';
import CompanyCard from '@components/CompanyCard.astro';
import RankedBarChart from '@components/RankedBarChart.astro';
import githubData from '../../public/data/github-windows.json';
import aaData from '../../public/data/aa-models.json';
import openrouterData from '../../public/data/openrouter.json';
import exploreycToday from '../../public/data/exploreyc-today.json';
import manifest from '../../public/data/manifest.json';

const locale = detectLocaleFromUrl(Astro.url);
const dict = getDict(locale);

const githubTop = githubData?.windows?.find(w => w.label === '7d')?.items?.slice(0, 8) ?? [];
const modelsTop = aaData?.rankings?.by_intelligence?.slice(0, 8) ?? [];
const orTop = openrouterData?.rankings?.week?.slice(0, 8) ?? [];
const todayItems = (exploreycToday?.items ?? []).map((it, idx) => ({ ...it, rank: idx + 1 }));
const lastUpdated = manifest?.generated_at;

const tagline = locale === 'es'
  ? 'La IA en 5 minutos al día — rankings y startups, en español.'
  : 'AI in 5 minutes a day — rankings and startups.';

// Datos para los bar charts.
function humanStars(n) {
  if (n == null) return '—';
  if (n >= 1000) return (n / 1000).toFixed(1) + 'k';
  return String(n);
}
const ghBars = githubTop.map((r) => ({
  rank: r.rank,
  name: r.full_name?.split('/')[1] ?? r.full_name,
  value: r.stargazers_count ?? 0,
  valueHuman: humanStars(r.stargazers_count) + ' ⭐',
  url: r.html_url,
}));
const modelsBars = modelsTop.map((m) => ({
  rank: m.rank,
  name: m.name,
  value: m.score ?? 0,
  valueHuman: (m.score ?? 0).toFixed(1) + ' pts',
  url: `https://artificialanalysis.ai/models/${m.slug || m.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
}));
const orBars = orTop.map((m) => ({
  rank: m.rank,
  name: m.name,
  value: Number(m.total_tokens ?? 0),
  valueHuman: '🪙 ' + (m.total_tokens_human ?? '0'),
  url: m.url,
}));
---

<Base locale={locale} dict={dict}>
  <section class="mb-10">
    <h1 class="text-3xl sm:text-4xl font-bold mb-3">{tagline}</h1>
    <p class="text-lg max-w-3xl" style="color: var(--text-muted);">{dict.home.intro}</p>
    {lastUpdated && (
      <p class="text-xs mt-4" style="color: var(--text-muted);">
        {dict.home.lastUpdated}: <time class="tabular-nums">{new Date(lastUpdated).toLocaleString(locale === 'es' ? 'es-CL' : 'en-US')}</time>
      </p>
    )}
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- GitHub widget -->
    <section>
      <header class="mb-4 flex items-baseline gap-2">
        <h2 class="text-xl font-semibold">{dict.home.sectionGithub}</h2>
        <span class="text-xs" style="color: var(--text-muted);">{dict.home.sectionGithubDesc}</span>
      </header>
      <div class="card p-4 mb-3">
        <RankedBarChart items={ghBars} topN={8} color="#22c55e" />
      </div>
      <a href={(locale === 'es' ? '' : '/en') + '/github/'} class="btn-tab inline-block">
        {dict.home.openGithub} →
      </a>
    </section>

    <!-- Models widget -->
    <section>
      <header class="mb-4 flex items-baseline gap-2">
        <h2 class="text-xl font-semibold">{dict.home.sectionModels}</h2>
        <span class="text-xs" style="color: var(--text-muted);">
          {dict.home.sectionModelsDesc}
          {aaData?.tier && <span class="badge ml-1">{aaData.tier.toUpperCase()}</span>}
        </span>
      </header>
      <div class="card p-4 mb-3">
        <RankedBarChart items={modelsBars} topN={8} color="#7c3aed" />
      </div>
      <a href={(locale === 'es' ? '' : '/en') + '/models/'} class="btn-tab inline-block">
        {dict.home.openModels} →
      </a>
    </section>

    <!-- OpenRouter widget -->
    <section>
      <header class="mb-4 flex items-baseline gap-2">
        <h2 class="text-xl font-semibold">{dict.home.sectionOpenRouter}</h2>
        <span class="text-xs" style="color: var(--text-muted);">{dict.home.sectionOpenRouterDesc}</span>
      </header>
      <div class="card p-4 mb-3">
        <RankedBarChart items={orBars} topN={8} color="#3b82f6" />
      </div>
      <a href={(locale === 'es' ? '' : '/en') + '/openrouter/'} class="btn-tab inline-block">
        {dict.home.openOpenRouter} →
      </a>
    </section>

    <!-- ExploreYC widget -->
    <section>
      <header class="mb-4 flex items-baseline gap-2">
        <h2 class="text-xl font-semibold">{dict.home.sectionExploreYC}</h2>
        <span class="text-xs" style="color: var(--text-muted);">{dict.home.sectionExploreYCDesc}</span>
      </header>
      <div class="space-y-3">
        {todayItems.length === 0 ? (
          <p class="card p-4 text-sm" style="color: var(--text-muted);">{dict.exploreyc.noResults}</p>
        ) : (
          todayItems.slice(0, 4).map((c) => <CompanyCard company={c} dict={dict} />)
        )}
      </div>
      <a href={(locale === 'es' ? '' : '/en') + '/exploreyc/'} class="btn-tab mt-3 inline-block">
        {dict.home.openExploreYC} →
      </a>
    </section>
  </div>
</Base>
